# Fastlane Appfile
# https://docs.fastlane.tools/advanced/Appfile/

# App Identifier (Bundle ID)
app_identifier(ENV['APP_IDENTIFIER'] || "com.yourcompany.FieldInspector")

# Apple ID email
apple_id(ENV['APPLE_ID'] || "your-apple-id@email.com")

# Team ID (from Apple Developer Portal)
team_id(ENV['TEAM_ID'] || "XXXXXXXXXX")

# App Store Connect Team ID (may be different from Developer Team ID)
itc_team_id(ENV['ITC_TEAM_ID'] || ENV['TEAM_ID'] || "XXXXXXXXXX")

# For more information about the Appfile, see:
# https://docs.fastlane.tools/advanced/Appfile/
